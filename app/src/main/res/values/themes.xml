<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.RamPT" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <!-- brak zaokrągleń w całej aplikacji — w Material3 zaokrąglenie komponentów (w tym przycisków)
             sterują atrybuty shapeAppearanceCorner*, NIE starsze shapeAppearance*Component (te działają
             tylko w Material2/nie są używane przez Widget.Material3.Button, stąd przyciski i tak wychodziły
             zaokrąglone mimo ich ustawienia poniżej — zostają dla komponentów, które jeszcze ich używają).
             Dodatkowo domyślny styl przycisków ustawiony wprost na warianty z cornerRadius=0dp, żeby mieć
             pewność niezależnie od tego, którego atrybutu kształtu użyje dany widget Material3. -->
        <item name="shapeAppearanceSmallComponent">@style/Shape.None</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.None</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.None</item>
        <item name="shapeAppearanceCornerExtraSmall">@style/Shape.None</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.None</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.None</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.None</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/Shape.None</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>
    </style>

    <style name="Shape.None" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <!-- domyślny styl WSZYSTKICH zwykłych przycisków (<Button> jest automatycznie inflate'owany jako
         MaterialButton w motywie Material3) — surowe, proste kąty zamiast domyślnego zaokrąglenia M3 -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">0dp</item>
        <item name="shapeAppearance">@style/Shape.None</item>
    </style>
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">0dp</item>
        <item name="shapeAppearance">@style/Shape.None</item>
    </style>

    <!-- opis techniczny: monospace, kursywa -->
    <style name="CardTitle">
        <item name="android:textStyle">italic</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- odczyt: monospace, jedna linia, bez zawijania -->
    <style name="Readout">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- pole tekstowe karty pomiarowej tokarki: pełna szerokość, ramka, maksymalnie ściśnięte w pionie -->
    <style name="TokarkaPole">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">@drawable/tokarka_pole_ramka</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
    </style>

    <!-- jak TokarkaPole, ale klawiatura numeryczna (znak + przecinek) -->
    <style name="TokarkaPoleLiczba" parent="TokarkaPole">
        <item name="android:inputType">numberDecimal|numberSigned</item>
    </style>

    <!-- etykieta nad polem w wierszu geometrii (jak <label> nad polem w karta_pomiaru_płaszczy.html);
         jedna linia zawsze - przy zbyt małej szerokości kolumny ucina z wielokropkiem zamiast łamać
         wiersz (to właśnie łamanie psuło układ przy większej czcionce systemowej). -->
    <style name="TokarkaEtykieta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">8sp</item>
        <item name="android:textColor">#666666</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- pole liczbowe w wierszu geometrii: dzieli szerokość wiersza wg wagi, ramka, maksymalnie ściśnięte w pionie.
         minWidth gwarantuje, że nawet przy ciasnym wierszu / dużej czcionce systemowej pole
         zostanie wystarczająco szerokie, żeby wpisana liczba była w całości widoczna. -->
    <style name="TokarkaPoleWiersz">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:inputType">numberDecimal|numberSigned</item>
        <item name="android:minHeight">22dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">@drawable/tokarka_pole_ramka</item>
        <item name="android:paddingStart">5dp</item>
        <item name="android:paddingEnd">5dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <!-- mały przycisk "Wyczyść X" (czerwony obrys, jak .mini-clear w oryginale) -->
    <style name="TokarkaWyczysc" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">#C0392B</item>
        <item name="strokeColor">#C0392B</item>
        <item name="cornerRadius">0dp</item>
        <item name="shapeAppearance">@style/Shape.None</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
    </style>

    <!-- przycisk-zakładka w pasku kart u góry karty pomiarowej (obok siebie, płaskie, bez zaokrągleń,
         dzielą równo szerokość paska) -->
    <style name="TokarkaZakladka" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">0dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="strokeColor">@color/brand_primary_container</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">0dp</item>
        <item name="shapeAppearance">@style/Shape.None</item>
        <item name="rippleColor">@color/brand_primary_container</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- dzielnik sekcji geometrii (kreskowana linia jak w oryginale), ściśnięty w pionie -->
    <style name="TokarkaDzielnik">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/tokarka_dzielnik</item>
    </style>
</resources>