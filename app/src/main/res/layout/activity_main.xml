<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLowest"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Tytuł + status + Zapisz + ikona BT -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Pomiary ZKS" android:textColor="@color/brand_primary"
                android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvStatus"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end" android:maxLines="1" android:ellipsize="end"
                android:textStyle="italic" android:textSize="11sp"
                android:text="@string/status_rozlaczono" />
            <Button android:id="@+id/btnSave"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:text="💾 Zapisz"
                android:textSize="9sp" app:cornerRadius="0dp"
                android:minHeight="0dp" android:minWidth="0dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:paddingTop="2dp" android:paddingBottom="2dp" />
            <ImageButton android:id="@+id/btnConn"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bt" android:scaleType="fitCenter"
                android:padding="6dp" android:contentDescription="Polacz/Rozlacz" />
        </LinearLayout>

        <!-- Akcje pomiaru — na samej górze -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" app:cardCornerRadius="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="6dp">

                <Button android:id="@+id/btnStartPomiar"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="▶ Start" android:textSize="9sp" android:layout_marginEnd="4dp"
                    android:contentDescription="Start pomiaru"
                    android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" />

                <Button android:id="@+id/btnStopPomiar"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="⏹ Stop" android:textSize="9sp" android:layout_marginEnd="4dp"
                    android:contentDescription="Koniec pomiaru"
                    android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" />

                <Button android:id="@+id/btnResetPomiar"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="🔄 Reset" android:textSize="9sp" android:layout_marginEnd="4dp"
                    android:contentDescription="Reset pomiaru"
                    android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" />

                <Button android:id="@+id/btnTabela"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="📋 Tabela" android:textSize="9sp" android:layout_marginEnd="4dp"
                    android:contentDescription="Tabela wyników"
                    android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" />

                <Button android:id="@+id/btnRaportWalca"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="📄 Raport" android:textSize="9sp"
                    android:contentDescription="Raport"
                    android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Parametry płaszcza + przełamanie spoiny wzdłużnej — jedna ramka, panele w kolorze jak w karcie tokarki -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" app:cardCornerRadius="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="6dp">

                <!-- ===== Panel: Parametry płaszcza (tło własne) ===== -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/bg_panel_geometria"
                    android:padding="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Parametry płaszcza" android:textStyle="bold" android:textSize="11sp"
                        android:layout_marginBottom="1dp" />

                    <!-- wiersz: ⌀ zadana | Grubość | Tol. bicia | Tol. walcowości — jedna linia, 4 równe kolumny -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="bottom">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:orientation="vertical" android:layout_marginEnd="6dp">
                            <TextView style="@style/TokarkaEtykieta" android:text="⌀ zadana [mm]" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <EditText android:id="@+id/etPromienZadany" style="@style/TokarkaPoleWiersz" />
                                <ImageButton android:id="@+id/btnWyslijR"
                                    android:layout_width="22dp" android:layout_height="22dp"
                                    android:layout_marginStart="3dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:src="@drawable/ic_promien" android:tint="@color/brand_secondary"
                                    android:scaleType="fitCenter" android:padding="2dp"
                                    android:contentDescription="Wyślij promień do urządzenia" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:orientation="vertical" android:layout_marginEnd="6dp">
                            <TextView style="@style/TokarkaEtykieta" android:text="Grubość e [mm]" />
                            <EditText android:id="@+id/etGrubosc" style="@style/TokarkaPoleWiersz" android:layout_weight="0" android:layout_width="match_parent" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:orientation="vertical" android:layout_marginEnd="6dp">
                            <TextView style="@style/TokarkaEtykieta" android:text="Tol. bicia [mm]" />
                            <EditText android:id="@+id/etTolBicie" style="@style/TokarkaPoleWiersz" android:layout_weight="0" android:layout_width="match_parent" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/TokarkaEtykieta" android:text="Tol. walcowości [mm]" />
                            <EditText android:id="@+id/etTolWalcowosc" style="@style/TokarkaPoleWiersz" android:layout_weight="0" android:layout_width="match_parent" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="11sp" android:text="norma owalności:" />
                        <Spinner android:id="@+id/spinTypKonstrukcji"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:textSize="9sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:text="tol. bicia/walcowości powyżej wyliczane z ⌀, grubości i wybranej normy (do pustych pól)" />
                </LinearLayout>

                <!-- ===== Panel: Przełamanie spoiny wzdłużnej (tło własne) ===== -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/bg_panel_spoiny"
                    android:padding="4dp" android:layout_marginTop="1dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Przełamanie spoiny wzdłużnej" android:textStyle="bold" android:textSize="11sp"
                        android:layout_marginBottom="1dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:orientation="vertical" android:layout_marginEnd="6dp">
                            <TextView style="@style/TokarkaEtykieta" android:text="Liczba spoin" />
                            <EditText android:id="@+id/etLiczbaSpoin" style="@style/TokarkaPoleWiersz" android:layout_weight="0" android:layout_width="match_parent" android:inputType="number" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/TokarkaEtykieta" android:text="Tol. przełamania [mm]" />
                            <EditText android:id="@+id/etTolPrzelamania" style="@style/TokarkaPoleWiersz" android:layout_weight="0" android:layout_width="match_parent" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="11sp" android:text="norma / obciążenie:" />
                        <Spinner android:id="@+id/spinWariantPrzelamania"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <TextView android:id="@+id/tvPrzelamanieInfo"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:textSize="11sp"
                        android:text="Przełamanie: brak symulacji" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Odczyt na żywo -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" app:cardCornerRadius="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Odczyt na żywo" android:textStyle="bold"
                    android:textColor="@color/brand_primary" android:textSize="12sp"
                    android:paddingBottom="6dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tvKat" style="@style/Readout"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Kat: –" />
                    <TextView android:id="@+id/tvL" style="@style/Readout"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textColor="@color/brand_secondary"
                        android:text="L: –" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tvX" style="@style/Readout"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="X: –" />
                    <TextView android:id="@+id/tvY" style="@style/Readout"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Y: –" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Profil na żywo -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" app:cardCornerRadius="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">

                <pl.rampt.app.PolarRoundnessView android:id="@+id/polarLive"
                    android:layout_width="match_parent" android:layout_height="300dp" />

                <TextView android:id="@+id/tvPomiarInfo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textSize="11sp"
                    android:visibility="gone" android:text="" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Symulator — zwinięty -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" app:cardCornerRadius="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <Button android:id="@+id/btnSymToggle"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="▸ Symulator" android:textSize="12sp" android:textStyle="bold"
                    android:textColor="@color/brand_primary"
                    app:cornerRadius="0dp" android:minHeight="0dp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp" />
                <LinearLayout android:id="@+id/simBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                    <Button android:id="@+id/btnSymLive"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Start symulacji" android:textSize="12sp"
                        app:cornerRadius="0dp" android:minHeight="0dp"
                        android:insetTop="0dp" android:insetBottom="0dp"
                        android:paddingTop="4dp" android:paddingBottom="4dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="12sp" android:text="predkosc:" />
                        <TextView android:id="@+id/tvSpeed" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="6dp"
                            android:minWidth="58dp" android:textStyle="bold"
                            android:text="10 st/s" />
                        <SeekBar android:id="@+id/seekSpeed" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:max="350" android:progress="0" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Log (zwijany) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <Button android:id="@+id/btnLogToggle"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="▸ Log" android:textSize="12sp" android:textStyle="bold"
                    android:textColor="@color/brand_primary"
                    app:cornerRadius="0dp" android:minHeight="0dp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp" />
                <ScrollView android:id="@+id/logScroll"
                    android:layout_width="match_parent" android:layout_height="140dp"
                    android:background="?attr/colorSurfaceContainerHigh"
                    android:visibility="gone">
                    <TextView android:id="@+id/tvLog"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="6dp" android:textSize="11sp" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
