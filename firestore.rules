rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lista dozwolonych użytkowników RamPT: jeden dokument na e-mail (ID dokumentu = e-mail
    // małymi literami, np. "jan.kowalski@firma.pl"). Treść dokumentu może być pusta ({}) —
    // liczy się wyłącznie jego istnienie.
    //
    // Każdy zalogowany użytkownik może odczytać WYŁĄCZNIE dokument o ID równym jego własnemu
    // e-mailowi z tokenu Firebase Auth — nie może więc sprawdzić ani wylistować czyjegoś
    // dostępu. Zapis jest zablokowany dla klientów (edycja listy wyłącznie z Konsoli Firebase).
    match /allowedEmails/{email} {
      allow get: if request.auth != null
                  && request.auth.token.email != null
                  && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }
  }
}
